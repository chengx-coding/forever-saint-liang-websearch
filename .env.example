# DeepSeek API key. Read from DEEPSEEK_API_KEY, or from WEBSEARCH_API_KEY as an alternative.
DEEPSEEK_API_KEY=sk-your-api-key-here

# Optional overrides. All of these also exist as settings.json keys and CLI flags.
# WEBSEARCH_SEARCH_ENDPOINT=https://api.deepseek.com/v1/tools/search
# WEBSEARCH_FETCH_ENDPOINT=https://api.deepseek.com/v1/tools/fetch
# WEBSEARCH_DEFAULT_COUNT=10
# WEBSEARCH_NEED_CONTENT=false
# WEBSEARCH_FETCH_MAX_CHARS=50000
# WEBSEARCH_TIMEOUT_MS=30000
