# DeepSeek API key. Read from DEEPSEEK_API_KEY, or from WEBSEARCH_API_KEY as an alternative.
DEEPSEEK_API_KEY=sk-your-api-key-here

# Model identifier.
# WEBSEARCH_MODEL is the canonical variable. DEEPSEEK_MODEL is still accepted as a legacy alias,
# and WEBSEARCH_MODEL wins whenever both are set.
WEBSEARCH_MODEL=deepseek-flash
