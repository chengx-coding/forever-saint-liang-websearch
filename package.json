{
  "name": "forever-saint-liang-websearch",
  "version": "0.5.0",
  "description": "An MCP server that provides web search and page fetch capabilities using DeepSeek's Search and Fetch APIs.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "forever-saint-liang-websearch": "./bin/forever-saint-liang-websearch"
  },
  "files": [
    "dist/",
    "bin/"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test \"tests/*.test.ts\""
  },
  "keywords": [
    "mcp",
    "deepseek",
    "web-search",
    "web-fetch",
    "model-context-protocol",
    "search"
  ],
  "author": "XChauncey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengx-coding/forever-saint-liang-websearch.git"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "commander": "^14.0.3",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
